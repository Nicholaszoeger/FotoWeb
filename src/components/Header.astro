---
// src/components/Header.astro
// Componente de navegación principal con menú responsive
// Incluye logo y enlaces a todas las páginas principales

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";

const navLinks = [
  { href: "/", label: "Inicio" },
  { href: "/sobre-nosotros", label: "Sobre Nosotros" },
  { href: "/servicios", label: "Servicios" },
  { href: "/proyectos", label: "Proyectos" },
  { href: "/personales", label: "Personales" },
  { href: "/contacto", label: "Contacto" },
];
---

<header class="bg-white border-b border-gray-200 sticky top-0 z-50 shadow-sm">
  <nav class="container mx-auto px-4 sm:px-6 lg:px-8 relative">
    <div class="flex justify-between items-center h-20">
      <!-- Logo -->
      <a href="/" class="flex items-center group">
        <img
          src="/logo.webp"
          alt="BittFilms"
          class="h-16 w-auto object-contain transition-opacity group-hover:opacity-75"
          width="200"
          height="48"
        />
      </a>

      <!-- Desktop Navigation -->
      <ul class="hidden md:flex space-x-8">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class={`text-sm font-medium transition-colors hover:text-gray-600 ${
                  currentPath === link.href
                    ? "text-gray-900 border-b-2 border-gray-900 pb-1"
                    : "text-gray-600"
                }`}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-button"
        class="md:hidden p-2 rounded-lg hover:bg-gray-100 transition-colors"
        aria-label="Abrir menú de navegación"
      >
        <svg
          class="w-6 h-6"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>

    <!-- Mobile Navigation -->
    <div
      id="mobile-menu"
      class="hidden md:hidden absolute left-0 right-0 top-full bg-white border-b border-gray-200 shadow-lg px-4 sm:px-6 lg:px-8 pt-4 pb-4"
    >
      <ul class="space-y-2">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class={`block py-2 px-4 rounded-lg text-sm font-medium transition-colors ${
                  currentPath === link.href
                    ? "bg-gray-900 text-white"
                    : "text-gray-600 hover:bg-gray-100"
                }`}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>
</header>

<script>
  // Script para toggle del menú móvil
  // Se reinicializa en cada navegación porque View Transitions no recarga la página
  function initMobileMenu() {
    const button = document.getElementById("mobile-menu-button");
    const menu = document.getElementById("mobile-menu");

    let menuJustOpened = false;

    button?.addEventListener("click", () => {
      menu?.classList.toggle("hidden");
      if (!menu?.classList.contains("hidden")) {
        menuJustOpened = true;
        setTimeout(() => (menuJustOpened = false), 300);
      }
    });

    const mobileLinks = menu?.querySelectorAll("a");
    mobileLinks?.forEach((link) => {
      link.addEventListener("click", () => {
        menu?.classList.add("hidden");
      });
    });

    window.addEventListener("scroll", () => {
      if (menuJustOpened) return;
      if (!menu?.classList.contains("hidden")) {
        menu?.classList.add("hidden");
      }
    }, { passive: true });
  }

  initMobileMenu();
  document.addEventListener("astro:page-load", initMobileMenu);
</script>
