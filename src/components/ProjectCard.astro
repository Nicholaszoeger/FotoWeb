---
// src/components/ProjectCard.astro
import { CldImage } from "astro-cloudinary";

interface Props {
  title: string;
  category: string;
  coverImage: string; // publicId de Cloudinary
  slug: string;
  description?: string;
}

const { title, category, coverImage, slug, description } = Astro.props;
---

<article class="group cursor-pointer">
  <a href={`/proyectos/${slug}`} class="block">
    <!-- Imagen optimizada con Cloudinary -->
    <div class="relative overflow-hidden bg-gray-100 aspect-[4/3] mb-4">
      <CldImage
        src={coverImage}
        width={800}
        height={600}
        crop="fill"
        gravity="auto"
        alt={title}
        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
        loading="lazy"
        format="auto"
        quality="auto"
      />
      <div
        class="absolute inset-0 bg-black opacity-0 group-hover:opacity-20 transition-opacity duration-300"
      >
      </div>
    </div>

    <!-- Información del proyecto -->
    <div>
      <p class="text-xs uppercase tracking-wider text-gray-500 mb-2">
        {category}
      </p>
      <h3
        class="text-xl font-serif font-semibold text-gray-900 mb-2 group-hover:text-gray-600 transition-colors"
      >
        {title}
      </h3>
      {
        description && (
          <p class="text-sm text-gray-600 line-clamp-2">{description}</p>
        )
      }
    </div>
  </a>
</article>
