---
// src/pages/index.astro
// Página principal del sitio - Presenta la empresa y sus mejores trabajos

import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { getFeaturedProjects } from "../data/projects";

const cloudName = import.meta.env.PUBLIC_CLOUDINARY_CLOUD_NAME ?? "";
const heroImageUrl = cloudName
  ? `https://res.cloudinary.com/${cloudName}/image/upload/f_auto,q_auto/_DSC5800_2_onuc1a_rmruxb.jpg`
  : "";

const featuredProjects = getFeaturedProjects();
---

<Layout
  title="Inicio"
  description="BittFilms - Estudio de fotografía profesional especializado en bodas, eventos, producto y fotografía corporativa en Madrid"
>
  <Header />

  <main>
    <!-- Hero Section -->
    <section
      class="relative h-screen flex items-center justify-center overflow-hidden bg-gray-900"
    >
      <img
        src={heroImageUrl}
        alt="Fotografía profesional"
        class="absolute inset-0 w-full h-full object-cover opacity-50"
        loading="eager"
      />

      <div class="relative z-10 text-center text-white px-4">
        <h1 class="text-5xl md:text-7xl font-serif font-bold mb-6">
          Capturamos Tu Historia
        </h1>
        <p class="text-xl md:text-2xl mb-8 max-w-2xl mx-auto font-light">
          Fotografía profesional con enfoque artístico y minimalista
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="/proyectos"
            class="bg-white text-gray-900 px-8 py-4 text-lg font-medium hover:bg-gray-100 transition-colors"
          >
            Ver Proyectos
          </a>
          <a
            href="/contacto"
            class="border-2 border-white text-white px-8 py-4 text-lg font-medium hover:bg-white hover:text-gray-900 transition-colors"
          >
            Contactar
          </a>
        </div>
      </div>

      <!-- Scroll indicator -->
      <div
        class="absolute bottom-8 left-1/2 transform -translate-x-1/2 animate-bounce"
      >
        <svg
          class="w-6 h-6 text-white"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
        </svg>
      </div>
    </section>

    <!-- Sobre Nosotros Breve -->
    <section class="py-20 bg-white">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-4xl text-center">
        <h2
          class="text-4xl md:text-5xl font-serif font-bold text-gray-900 mb-6"
        >
          Fotografía con Alma
        </h2>
        <p class="text-lg text-gray-600 leading-relaxed mb-8">
          En BittFilms creemos que cada imagen cuenta una historia única.
          Nuestro enfoque minimalista y elegante captura la esencia de cada
          momento, transformando instantes fugaces en recuerdos eternos. Con más
          de 10 años de experiencia, nos especializamos en crear imágenes
          atemporales que trascienden las tendencias.
        </p>
        <a
          href="/sobre-nosotros"
          class="inline-block text-gray-900 border-b-2 border-gray-900 pb-1 hover:text-gray-600 hover:border-gray-600 transition-colors font-medium"
        >
          Conocer Más Sobre Nosotros →
        </a>
      </div>
    </section>

    <!-- Servicios Destacados -->
    <section class="py-20 bg-gray-50">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2
            class="text-4xl md:text-5xl font-serif font-bold text-gray-900 mb-4"
          >
            Nuestros Servicios
          </h2>
          <p class="text-lg text-gray-600 max-w-2xl mx-auto">
            Ofrecemos soluciones fotográficas adaptadas a tus necesidades
          </p>
        </div>

        <div
          class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 max-w-6xl mx-auto"
        >
          <div class="text-center">
            <div class="text-5xl mb-4">💍</div>
            <h3 class="text-xl font-serif font-semibold mb-2">Bodas</h3>
            <p class="text-sm text-gray-600">Momentos únicos e inolvidables</p>
          </div>
          <div class="text-center">
            <div class="text-5xl mb-4">🎉</div>
            <h3 class="text-xl font-serif font-semibold mb-2">Eventos</h3>
            <p class="text-sm text-gray-600">Celebraciones llenas de vida</p>
          </div>
          <div class="text-center">
            <div class="text-5xl mb-4">📦</div>
            <h3 class="text-xl font-serif font-semibold mb-2">Producto</h3>
            <p class="text-sm text-gray-600">Imágenes que venden</p>
          </div>
          <div class="text-center">
            <div class="text-5xl mb-4">💼</div>
            <h3 class="text-xl font-serif font-semibold mb-2">Corporativa</h3>
            <p class="text-sm text-gray-600">Profesionalismo visual</p>
          </div>
        </div>

        <div class="text-center mt-12">
          <a
            href="/servicios"
            class="inline-block bg-gray-900 text-white px-8 py-3 hover:bg-gray-800 transition-colors font-medium"
          >
            Ver Todos los Servicios
          </a>
        </div>
      </div>
    </section>

    <!-- Proyectos Destacados -->
    <section class="py-20 bg-white">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2
            class="text-4xl md:text-5xl font-serif font-bold text-gray-900 mb-4"
          >
            Proyectos Destacados
          </h2>
          <p class="text-lg text-gray-600 max-w-2xl mx-auto">
            Una selección de nuestros trabajos más recientes
          </p>
        </div>

        <div
          class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-6xl mx-auto"
        >
          {featuredProjects.map((project) => <ProjectCard {...project} />)}
        </div>

        <div class="text-center mt-12">
          <a
            href="/proyectos"
            class="inline-block text-gray-900 border-b-2 border-gray-900 pb-1 hover:text-gray-600 hover:border-gray-600 transition-colors font-medium"
          >
            Ver Todos los Proyectos →
          </a>
        </div>
      </div>
    </section>

    <!-- Call to Action Final -->
    <section class="py-20 bg-gray-900 text-white">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-4xl md:text-5xl font-serif font-bold mb-6">
          ¿Listo para Crear Algo Único?
        </h2>
        <p class="text-xl mb-8 max-w-2xl mx-auto">
          Hablemos de tu proyecto y convirtamos tu visión en imágenes
          inolvidables
        </p>
        <a
          href="/contacto"
          class="inline-block bg-white text-gray-900 px-8 py-4 text-lg font-medium hover:bg-gray-100 transition-colors"
        >
          Contactar Ahora
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
