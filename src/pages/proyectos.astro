---
// src/pages/proyectos.astro
// Página que muestra el portfolio completo de proyectos profesionales

import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { projects } from "../data/projects";

const categories = ["Todos", "Bodas", "Producto", "Corporativa", "Eventos"];
---

<Layout
  title="Proyectos"
  description="Explora nuestro portfolio de proyectos profesionales: bodas, eventos, fotografía corporativa y de producto. Más de 10 años de experiencia capturando momentos únicos."
>
  <Header />

  <main>
    <!-- Hero Section -->
    <section
      class="relative h-96 flex items-center justify-center overflow-hidden bg-gray-900"
    >
      <img
        src="https://images.unsplash.com/photo-1452587925148-ce544e77e70d?w=1920&h=600&fit=crop"
        alt="Portfolio de proyectos"
        class="absolute inset-0 w-full h-full object-cover opacity-40"
      />
      <div class="relative z-10 text-center text-white px-4">
        <h1 class="text-5xl md:text-6xl font-serif font-bold mb-4">
          Nuestros Proyectos
        </h1>
        <p class="text-xl max-w-2xl mx-auto">
          Una selección de nuestros trabajos más destacados
        </p>
      </div>
    </section>

    <!-- Filtros por Categoría -->
    <section class="bg-white sticky top-20 z-40">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-6">
        <!-- Desplegable personalizado en móvil -->
        <div class="md:hidden relative">
          <button
            id="category-dropdown-btn"
            type="button"
            class="w-full flex items-center justify-between pl-11 pr-4 py-3 text-sm font-medium text-gray-900 bg-white cursor-pointer relative"
            aria-haspopup="listbox"
            aria-expanded="false"
          >
            <svg
              class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-500"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 4h18M6 8h12M9 12h6M11 16h2"></path>
            </svg>
            <span id="category-dropdown-label">Todos</span>
            <svg
              id="category-dropdown-chevron"
              class="w-4 h-4 text-gray-500 transition-transform duration-200"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>

          <ul
            id="category-dropdown-list"
            role="listbox"
            class="hidden absolute left-0 right-0 top-full mt-1 bg-white shadow-lg z-50 overflow-hidden"
          >
            {
              categories.map((category) => (
                <li role="option">
                  <button
                    type="button"
                    class="dropdown-option w-full text-left px-4 py-3 text-sm font-medium text-gray-700 hover:bg-gray-100 transition-colors"
                    data-category={category}
                  >
                    {category}
                  </button>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- Botones en escritorio -->
        <div class="hidden md:flex flex-wrap justify-center gap-4">
          {
            categories.map((category) => (
              <button
                class="filter-btn px-6 py-2 border border-gray-300 hover:border-gray-900 hover:bg-gray-900 hover:text-white transition-colors text-sm font-medium"
                data-category={category}
              >
                {category}
              </button>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Grid de Proyectos -->
    <section class="py-16 bg-white">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div
          id="projects-grid"
          class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8"
        >
          {
            projects.map((project) => (
              <div class="project-item" data-category={project.category}>
                <ProjectCard {...project} />
              </div>
            ))
          }
        </div>

        <!-- Mensaje cuando no hay resultados -->
        <div id="no-results" class="hidden text-center py-16">
          <p class="text-gray-600 text-lg">
            No se encontraron proyectos en esta categoría
          </p>
        </div>
      </div>
    </section>

    <!-- Call to Action -->
    <section class="py-20 bg-gray-900 text-white">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-4xl font-serif font-bold mb-6">
          ¿Tienes un Proyecto en Mente?
        </h2>
        <p class="text-xl mb-8 max-w-2xl mx-auto">
          Nos encantaría ser parte de tu próxima historia visual
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="/contacto"
            class="inline-block bg-white text-gray-900 px-8 py-4 text-lg font-medium hover:bg-gray-100 transition-colors"
          >
            Contactar
          </a>
          <a
            href="/personales"
            class="inline-block border-2 border-white text-white px-8 py-4 text-lg font-medium hover:bg-white hover:text-gray-900 transition-colors"
          >
            Ver Proyectos Personales
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  function initProjectFilters() {
    const firstBtn = document.querySelector(".filter-btn");
    if (!firstBtn || (firstBtn as HTMLElement).dataset.filterInit === "true") return;
    (firstBtn as HTMLElement).dataset.filterInit = "true";

    const filterButtons = document.querySelectorAll(".filter-btn");
    const dropdownOptions = document.querySelectorAll(".dropdown-option");
    const projectItems = document.querySelectorAll(".project-item");
    const noResults = document.getElementById("no-results");

    const dropdownBtn = document.getElementById("category-dropdown-btn");
    const dropdownList = document.getElementById("category-dropdown-list");
    const dropdownLabel = document.getElementById("category-dropdown-label");
    const dropdownChevron = document.getElementById("category-dropdown-chevron");

    function openDropdown() {
      dropdownList?.classList.remove("hidden");
      dropdownChevron?.classList.add("rotate-180");
      dropdownBtn?.setAttribute("aria-expanded", "true");
    }

    function closeDropdown() {
      dropdownList?.classList.add("hidden");
      dropdownChevron?.classList.remove("rotate-180");
      dropdownBtn?.setAttribute("aria-expanded", "false");
    }

    dropdownBtn?.addEventListener("click", () => {
      if (dropdownList?.classList.contains("hidden")) {
        openDropdown();
      } else {
        closeDropdown();
      }
    });

    document.addEventListener("click", (e) => {
      const target = e.target as Node;
      if (!dropdownList?.contains(target) && !dropdownBtn?.contains(target)) {
        closeDropdown();
      }
    });

    function applyFilter(category: string) {
      filterButtons.forEach((btn) => {
        btn.classList.remove("bg-gray-900", "text-white", "border-gray-900");
      });
      const matchingButton = document.querySelector(`.filter-btn[data-category="${category}"]`);
      matchingButton?.classList.add("bg-gray-900", "text-white", "border-gray-900");

      dropdownOptions.forEach((opt) => {
        opt.classList.remove("bg-gray-100", "font-semibold");
      });
      const matchingOption = document.querySelector(`.dropdown-option[data-category="${category}"]`);
      matchingOption?.classList.add("bg-gray-100", "font-semibold");

      if (dropdownLabel) dropdownLabel.textContent = category;

      let visibleCount = 0;
      projectItems.forEach((item) => {
        const itemCategory = item.getAttribute("data-category");

        if (category === "Todos" || itemCategory === category) {
          item.classList.remove("hidden");
          visibleCount++;
        } else {
          item.classList.add("hidden");
        }
      });

      if (noResults) {
        if (visibleCount === 0) {
          noResults.classList.remove("hidden");
        } else {
          noResults.classList.add("hidden");
        }
      }
    }

    filterButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const category = button.getAttribute("data-category") ?? "Todos";
        applyFilter(category);
      });
    });

    dropdownOptions.forEach((option) => {
      option.addEventListener("click", () => {
        const category = option.getAttribute("data-category") ?? "Todos";
        applyFilter(category);
        closeDropdown();
      });
    });

    const todosButton = document.querySelector('.filter-btn[data-category="Todos"]');
    todosButton?.classList.add("bg-gray-900", "text-white", "border-gray-900");

    const todosOption = document.querySelector('.dropdown-option[data-category="Todos"]');
    todosOption?.classList.add("bg-gray-100", "font-semibold");
  }

  initProjectFilters();
  document.addEventListener("astro:page-load", initProjectFilters);
</script>
