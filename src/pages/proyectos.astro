---
// src/pages/proyectos.astro
// Página que muestra el portfolio completo de proyectos profesionales

import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ProjectCard from "../components/ProjectCard.astro";

// En producción, estos datos vendrían de una colección de Astro o CMS
const projects = [
  {
    title: "Boda en la Costa Mediterránea",
    category: "Bodas",
    image:
      "https://images.unsplash.com/photo-1519741497674-611481863552?w=800&h=600&fit=crop",
    slug: "boda-costa-mediterranea",
    description:
      "Una ceremonia íntima junto al mar con luz natural perfecta y puesta de sol inolvidable",
  },
  {
    title: "Lanzamiento Producto Tecnológico",
    category: "Producto",
    image:
      "https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=800&h=600&fit=crop",
    slug: "producto-tech-launch",
    description:
      "Fotografía de producto para el lanzamiento de nueva línea de auriculares premium",
  },
  {
    title: "Sesión Corporativa StartUp",
    category: "Corporativa",
    image:
      "https://images.unsplash.com/photo-1556761175-b413da4baf72?w=800&h=600&fit=crop",
    slug: "sesion-corporativa-tech",
    description:
      "Retratos profesionales y fotografía de equipo para startup tecnológica en crecimiento",
  },
  {
    title: "Evento Gala Benéfica",
    category: "Eventos",
    image:
      "https://images.unsplash.com/photo-1511795409834-ef04bbd61622?w=800&h=600&fit=crop",
    slug: "gala-benefica-2024",
    description:
      "Cobertura completa de gala benéfica anual con más de 300 asistentes",
  },
  {
    title: "Joyería Artesanal Premium",
    category: "Producto",
    image:
      "https://images.unsplash.com/photo-1515562141207-7a88fb7ce338?w=800&h=600&fit=crop",
    slug: "joyeria-artesanal",
    description: "Catálogo fotográfico para marca de joyería artesanal de lujo",
  },
  {
    title: "Boda en Jardín Botánico",
    category: "Bodas",
    image:
      "https://images.unsplash.com/photo-1606800052052-a08af7148866?w=800&h=600&fit=crop",
    slug: "boda-jardin-botanico",
    description:
      "Ceremonia elegante rodeada de naturaleza y flores en plena primavera",
  },
  {
    title: "Retratos Ejecutivos CEO",
    category: "Corporativa",
    image:
      "https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?w=800&h=600&fit=crop",
    slug: "retratos-ejecutivos",
    description:
      "Serie de retratos corporativos para perfiles ejecutivos y LinkedIn",
  },
  {
    title: "Moda Sostenible 2024",
    category: "Producto",
    image:
      "https://images.unsplash.com/photo-1490481651871-ab68de25d43d?w=800&h=600&fit=crop",
    slug: "moda-sostenible",
    description: "Lookbook para marca de moda sostenible y ética",
  },
  {
    title: "Conferencia Tech Summit",
    category: "Eventos",
    image:
      "https://images.unsplash.com/photo-1540575467063-178a50c2df87?w=800&h=600&fit=crop",
    slug: "tech-summit-2024",
    description:
      "Cobertura fotográfica de conferencia tecnológica de tres días",
  },
  {
    title: "Boda Destino en Mallorca",
    category: "Bodas",
    image:
      "https://images.unsplash.com/photo-1591604466107-ec97de577aff?w=800&h=600&fit=crop",
    slug: "boda-destino-mallorca",
    description:
      "Boda de destino en finca mallorquina con vistas al mediterráneo",
  },
  {
    title: "Restaurante Gourmet",
    category: "Producto",
    image:
      "https://images.unsplash.com/photo-1414235077428-338989a2e8c0?w=800&h=600&fit=crop",
    slug: "restaurante-gourmet",
    description:
      "Fotografía gastronómica para menú y campaña de redes sociales",
  },
  {
    title: "Oficinas Corporativas",
    category: "Corporativa",
    image:
      "https://images.unsplash.com/photo-1497366216548-37526070297c?w=800&h=600&fit=crop",
    slug: "oficinas-corporativas",
    description: "Fotografía arquitectónica y de espacios para nuevas oficinas",
  },
];

const categories = ["Todos", "Bodas", "Producto", "Corporativa", "Eventos"];
---

<Layout
  title="Proyectos"
  description="Explora nuestro portfolio de proyectos profesionales: bodas, eventos, fotografía corporativa y de producto. Más de 10 años de experiencia capturando momentos únicos."
>
  <Header />

  <main>
    <!-- Hero Section -->
    <section
      class="relative h-96 flex items-center justify-center overflow-hidden bg-gray-900"
    >
      <img
        src="https://images.unsplash.com/photo-1452587925148-ce544e77e70d?w=1920&h=600&fit=crop"
        alt="Portfolio de proyectos"
        class="absolute inset-0 w-full h-full object-cover opacity-40"
      />
      <div class="relative z-10 text-center text-white px-4">
        <h1 class="text-5xl md:text-6xl font-serif font-bold mb-4">
          Nuestros Proyectos
        </h1>
        <p class="text-xl max-w-2xl mx-auto">
          Una selección de nuestros trabajos más destacados
        </p>
      </div>
    </section>

    <!-- Filtros por Categoría -->
    <section class="bg-white border-b border-gray-200 sticky top-20 z-40">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-6">
        <div class="flex flex-wrap justify-center gap-4">
          {
            categories.map((category) => (
              <button
                class="filter-btn px-6 py-2 border border-gray-300 hover:border-gray-900 hover:bg-gray-900 hover:text-white transition-colors text-sm font-medium"
                data-category={category}
              >
                {category}
              </button>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Grid de Proyectos -->
    <section class="py-16 bg-white">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div
          id="projects-grid"
          class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8"
        >
          {
            projects.map((project) => (
              <div class="project-item" data-category={project.category}>
                <ProjectCard {...project} />
              </div>
            ))
          }
        </div>

        <!-- Mensaje cuando no hay resultados -->
        <div id="no-results" class="hidden text-center py-16">
          <p class="text-gray-600 text-lg">
            No se encontraron proyectos en esta categoría
          </p>
        </div>
      </div>
    </section>

    <!-- Call to Action -->
    <section class="py-20 bg-gray-900 text-white">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-4xl font-serif font-bold mb-6">
          ¿Tienes un Proyecto en Mente?
        </h2>
        <p class="text-xl mb-8 max-w-2xl mx-auto">
          Nos encantaría ser parte de tu próxima historia visual
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="/contacto"
            class="inline-block bg-white text-gray-900 px-8 py-4 text-lg font-medium hover:bg-gray-100 transition-colors"
          >
            Contactar
          </a>
          <a
            href="/personales"
            class="inline-block border-2 border-white text-white px-8 py-4 text-lg font-medium hover:bg-white hover:text-gray-900 transition-colors"
          >
            Ver Proyectos Personales
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  // Funcionalidad de filtrado de proyectos
  const filterButtons = document.querySelectorAll(".filter-btn");
  const projectItems = document.querySelectorAll(".project-item");
  const noResults = document.getElementById("no-results");

  filterButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const category = button.getAttribute("data-category");

      // Actualizar estado activo de botones
      filterButtons.forEach((btn) => {
        btn.classList.remove("bg-gray-900", "text-white", "border-gray-900");
      });
      button.classList.add("bg-gray-900", "text-white", "border-gray-900");

      // Filtrar proyectos
      let visibleCount = 0;
      projectItems.forEach((item) => {
        const itemCategory = item.getAttribute("data-category");

        if (category === "Todos" || itemCategory === category) {
          item.classList.remove("hidden");
          visibleCount++;
        } else {
          item.classList.add("hidden");
        }
      });

      // Mostrar mensaje si no hay resultados
      if (noResults) {
        if (visibleCount === 0) {
          noResults.classList.remove("hidden");
        } else {
          noResults.classList.add("hidden");
        }
      }
    });
  });

  // Activar "Todos" por defecto
  const todosButton = document.querySelector('[data-category="Todos"]');
  if (todosButton) {
    todosButton.classList.add("bg-gray-900", "text-white", "border-gray-900");
  }
</script>
