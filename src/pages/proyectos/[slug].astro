---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Gallery from "../../components/Gallery.astro";
import { projects, getProjectBySlug } from "../../data/projects";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
  }));
}

const { slug } = Astro.params;
const project = getProjectBySlug(slug);

if (!project) {
  return Astro.redirect("/404");
}
---

<Layout title={project.title} description={project.description}>
  <Header />

  <main>
    <!-- Navegación de retorno -->
    <div class="bg-gray-50 border-b border-gray-200">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-4">
        <a
          href="/proyectos"
          class="inline-flex items-center text-gray-600 hover:text-gray-900 transition-colors"
        >
          <svg
            class="w-5 h-5 mr-2"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M15 19l-7-7 7-7"></path>
          </svg>
          Volver a Proyectos
        </a>
      </div>
    </div>

    <!-- Información del Proyecto -->
    <section class="py-16 bg-white">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-4xl">
        <p class="text-sm uppercase tracking-wider text-gray-500 mb-4">
          {project.category}
        </p>

        <h1
          class="text-4xl md:text-5xl font-serif font-bold text-gray-900 mb-6"
        >
          {project.title}
        </h1>

        <div class="flex flex-wrap gap-6 mb-8 text-sm text-gray-600">
          <div>
            <span class="font-semibold text-gray-900">Cliente:</span>
            {project.client}
          </div>
          <div>
            <span class="font-semibold text-gray-900">Fecha:</span>
            {project.date}
          </div>
          <div>
            <span class="font-semibold text-gray-900">Ubicación:</span>
            {project.location}
          </div>
        </div>

        <div class="prose prose-lg max-w-none mb-12">
          <p class="text-gray-700 leading-relaxed text-lg mb-6">
            {project.description}
          </p>

          <h2 class="text-2xl font-serif font-semibold text-gray-900 mb-4">
            El Desafío
          </h2>
          <p class="text-gray-700 leading-relaxed mb-6">
            {project.challenge}
          </p>

          <h2 class="text-2xl font-serif font-semibold text-gray-900 mb-4">
            Nuestra Solución
          </h2>
          <p class="text-gray-700 leading-relaxed">
            {project.solution}
          </p>
        </div>
      </div>
    </section>

    <!-- Galería -->
    <section class="py-16 bg-gray-50">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <h2
          class="text-3xl font-serif font-bold text-gray-900 mb-8 text-center"
        >
          Galería del Proyecto
        </h2>
        <Gallery images={project.images} columns={3} />
      </div>
    </section>

    <!-- CTA -->
    <section class="py-20 bg-white">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-3xl font-serif font-bold text-gray-900 mb-6">
          ¿Te Gustó Este Proyecto?
        </h2>
        <p class="text-lg text-gray-600 mb-8 max-w-2xl mx-auto">
          Podemos crear algo igual de especial para ti
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="/contacto"
            class="inline-block bg-gray-900 text-white px-8 py-4 text-lg font-medium hover:bg-gray-800 transition-colors"
          >
            Iniciar un Proyecto
          </a>
          <a
            href="/proyectos"
            class="inline-block border-2 border-gray-900 text-gray-900 px-8 py-4 text-lg font-medium hover:bg-gray-900 hover:text-white transition-colors"
          >
            Ver Más Proyectos
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
